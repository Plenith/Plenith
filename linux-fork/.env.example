# Plenith linux-fork environment.
#
# Copy this to `.env` (in the same directory as docker-compose.yml) and fill
# in the values for your deployment. `docker compose up` auto-reads .env
# and substitutes ${VAR} references in the compose file.
#
# DO NOT commit `.env` — only `.env.example`. The deployment_id is the
# install-time secret that makes your decoy content unforgeable.

# --- Content rotation (recommended) ----------------------------------------
# A stable per-install id. Generate once at deploy time with:
#   uuidgen | tr -d '\n'
# Two Plenith installs at different orgs MUST use different ids — that's
# what makes them look like two different companies' infrastructure rather
# than two copies of the same honeypot.
PLENITH_DEPLOYMENT_ID=replace-me-with-a-uuid

# Quarterly rotation epoch. Bump on every content rotation to regenerate
# every artifact (sudoers, my.cnf, banner, ssh_config, motd, history).
# Recommended cadence: quarterly, or whenever a previous epoch's content
# leaks into a public IoC feed.
PLENITH_CONTENT_EPOCH=2026Q2
